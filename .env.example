# ConnectedVCS Tools Environment Variables
# Copy this file to .env and fill in your actual values.
# See docs/Environment_Variables.md for details.
#
# IMPORTANT: Never commit the .env file to version control.

# Google Maps API Key (required for Places Autocomplete)
GOOGLE_MAP_API_KEY=

# Azure Maps API Key (required for base map tiles)
AZURE_MAP_API_KEY=

# Esri ArcGIS API Key (required for elevation service)
ESRI_MAP_API_KEY=

# AWS S3 Configuration (optional — for tile caching)
# AWS_S3_BUCKET=
# AWS_S3_REGION=us-east-1
# AWS_S3_ACCESSKEY=
# AWS_S3_SECRETKEY=
